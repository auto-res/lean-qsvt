#!/usr/bin/env bash
# Command-line front end of lean-qsvt (plan Phase 7 / CIRC-6): runs tools/qsvt_cli.lean as a
# script (no `lean_exe`): every run re-elaborates it, about 8 s of which 6 s load the oleans.
# `tools/qsvt help` lists the commands.
set -euo pipefail
cd "$(dirname "$0")/.." && exec lake env lean --run tools/qsvt_cli.lean "$@"
